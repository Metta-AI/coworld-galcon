version = "0.1.0"
author = "Phil Hassey (original Galcon), Nim port contributors"
description = "A faithful Nim port of Phil Hassey's Galcon 2006 on Polyworld."
license = "GPL-2.0"
srcDir = "src"
bin = @["galcon"]

requires "nim >= 2.2.10"
requires "https://github.com/Metta-AI/polyworld"
requires "https://github.com/treeform/bassy"
requires "https://github.com/treeform/fixxy"
requires "silky"
requires "pixie"
requires "windy"
requires "vmath"
requires "chroma"
requires "bumpy"
requires "opengl"
requires "slappy"
requires "jsony"
requires "flatty"
requires "benchy"
requires "fluffy >= 1.0.0"
